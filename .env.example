# ============================================================
#  Motor Glosas HUS — Variables de entorno requeridas
#  Copia este archivo como .env y completa los valores reales
# ============================================================

# ----- Base de datos ----------------------------------------
# SQLite local (desarrollo):
DATABASE_URL=sqlite:///./glosas.db

# PostgreSQL producción (Render, Fly.io, Supabase, etc.):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/glosas_hus

# ----- Seguridad JWT (OBLIGATORIO) --------------------------
# Generar en consola con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_MINIMO_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----- Contraseña del admin inicial (OBLIGATORIO) -----------
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_AQUI

# ----- Llaves de IA (Escuadrón Gratuito de Relevos) ---------
# Consigue tus llaves gratis en los paneles de desarrollador:
# Groq: https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=tu_cohere_api_key_aqui

# Anthropic (Claude - Opcional / Pago):
ANTHROPIC_API_KEY=

# ----- Enrutador y Modelos Activos --------------------------
PRIMARY_AI=groq

# Configuración de los modelos de Groq (cadena actualizada jun-2026)
# Primario: Llama 4 Scout (17B activos / 128 expertos MoE, 8M contexto)
# Si falla, cae a los fallbacks en orden. Ver config.py para la lista.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FALLBACK_1=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK_2=qwen/qwen3-32b
GROQ_MODEL_FALLBACK_3=llama-3.3-70b-versatile

# Modelo Gemini por defecto (para OCR de PDFs escaneados)
# gemini-2.0-flash-exp fue deprecado; 2.0-flash es la versión GA actual.
GEMINI_MODEL=gemini-2.0-flash

# ----- CORS: dominios permitidos (desarrollo + producción) --
# En desarrollo local DEBE incluir http://localhost:5173 (tu nuevo React)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hus.gov.co,https://motor-glosas.hus.gov.co

# ----- Configuración de correo para alertas -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alertas@hus.gov.co
SMTP_PASSWORD=contraseña_app_gmail_16_caracteres
SMTP_FROM=noreply@hus.gov.co

# Destinatarios de alertas (separados por coma)
ALERTAS_EMAIL=cartera@hus.gov.co

# ----- Metadatos de la app ----------------------------------
APP_NAME=Motor Glosas HUS
APP_VERSION=5.4.0