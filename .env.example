# ============================================================
#  Motor Glosas HUS — Variables de entorno requeridas
#  Copia este archivo como .env y completa los valores reales
# ============================================================

# ----- Base de datos ----------------------------------------
# SQLite local (desarrollo):
DATABASE_URL=sqlite:///./glosas.db

# PostgreSQL producción (Render, Fly.io, Supabase, etc.):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/glosas_hus

# ----- Seguridad JWT (OBLIGATORIO) --------------------------
# Generar en consola con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_MINIMO_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----- Contraseña del admin inicial (OBLIGATORIO) -----------
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_AQUI

# ----- Llaves de IA (Escuadrón Gratuito de Relevos) ---------
# Consigue tus llaves gratis en los paneles de desarrollador:
# Groq: https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Knobs opcionales (auditoría jul-2026) ─────────────────────────
# PRIMARY_AI=groq                 # o "anthropic"
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL_OPUS=claude-opus-4-7  # modelo para casos >= $10M + 2 PDFs
# SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM=
# ALERTAS_EMAIL=                  # destinatario de alertas
# GLOSAS_ENCRYPTION_KEY=          # Fernet — estable entre reinicios
# CRED_VAULT_KEY=                 # Fernet — estable entre reinicios

# Anthropic (Claude - Opcional / Pago):
ANTHROPIC_API_KEY=

# ----- Enrutador y Modelos Activos --------------------------
PRIMARY_AI=groq

# Modelos de Groq. Si falla uno, cae al siguiente en orden.
#
# 05-08-2026: meta-llama/llama-4-scout-17b-16e-instruct SALIO del catalogo de
# Groq y devuelve «404 - the model does not exist or you do not have access to
# it». Ese dia se corrigio config.py pero NO este archivo, y los PC que se
# montaron copiando .env.example quedaron con el modelo muerto de primario:
# cada dictamen gasta una llamada fallida antes de caer al respaldo, y el
# panel muestra como «primario» un modelo que nunca responde. 19-08-2026.
#
# Estas cuatro lineas deben coincidir con los valores por defecto de
# app/core/config.py — hay una prueba que lo vigila.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK_1=qwen/qwen3-32b
GROQ_MODEL_FALLBACK_2=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK_3=llama-3.1-8b-instant

# Modelo Gemini para OCR de PDF escaneados.
# 19-08-2026: gemini-2.0-flash SE RETIRO («404 - is no longer available»), como
# antes 2.0-flash-exp. Se usa el alias `gemini-flash-latest`, que Google
# mantiene apuntando al Flash vigente, para que el OCR no se muera solo.
GEMINI_MODEL=gemini-flash-latest

# ----- Mejora #3: salida estructurada incremental -----------
# OFF por defecto. Cuando está ON, la IA confirma los campos críticos
# (EPS, servicio, contrato, cláusulas, sanción, sub-conceptos) en un
# bloque JSON que el motor cruza contra los valores deterministas, y
# registra divergencias en el log ([CAMPOS-EST]). Reversible: volver a 0.
# GLOSA_CAMPOS_ESTRUCTURADOS=true
GLOSA_CAMPOS_ESTRUCTURADOS=0

# ----- Agente de Lotes (tools/AgenteLotes.pyw) --------------
# Token compartido entre el servidor y el agente del PC del hospital.
# Generar una cadena larga aleatoria propia (ej: openssl rand -hex 32) y
# poner LA MISMA en la ventana del agente. NUNCA committear el valor real:
# este archivo es un ejemplo y queda en el historial de git.
AGENTE_LOTES_TOKEN=CAMBIAR_POR_UNA_CADENA_LARGA_ALEATORIA

# ----- CORS: dominios permitidos (desarrollo + producción) --
# En desarrollo local DEBE incluir http://localhost:5173 (tu nuevo React)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hus.gov.co,https://motor-glosas.hus.gov.co

# ----- Configuración de correo para alertas -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alertas@hus.gov.co
SMTP_PASSWORD=contraseña_app_gmail_16_caracteres
SMTP_FROM=noreply@hus.gov.co

# Destinatarios de alertas (separados por coma)
ALERTAS_EMAIL=cartera@hus.gov.co

# ----- Motor de Vencimientos --------------------------------
# Avisa antes de que una glosa se venza. Nació de un caso real: tres facturas
# de junio con 38 objeciones por $20.054.751 se descubrieron 45 días tarde.
#
# La cuenta emisora (SMTP_FROM, arriba) debe ser INSTITUCIONAL —del estilo
# sinac.alertas@hus.gov.co— y nunca personal: el aviso tiene que sobrevivir a
# los cambios de personas.
#
# Días de anticipación de cada nivel:
VENCIMIENTOS_DIAS_PREVENTIVO=10
VENCIMIENTOS_DIAS_ALTA=5
VENCIMIENTOS_DIAS_CRITICA=2
#
# Quién recibe qué. Dos reglas de gobierno:
#   1. El gestor recibe SIEMPRE sus casos, en todos los niveles.
#   2. El escalamiento entra al superar el umbral y NO se repite: a quien se
#      declara en ALTA le llegan ALTA, CRÍTICA y VENCIDA. Por eso el
#      coordinador se declara una sola vez.
#
#   Preventivo (10 días) → gestor · analista responsable
#   Alta       (5 días)  → gestor · coordinador de cartera/glosas
#   Crítica    (2 días)  → gestor · coordinador · líder financiero
#   Vencida              → gestor · coordinador · dirección financiera ·
#                          auditoría interna
VENCIMIENTOS_CORREO_GESTOR=1
VENCIMIENTOS_CORREO_PREVENTIVO=analista.glosas@hus.gov.co
VENCIMIENTOS_CORREO_ALTA=coordinacion.cartera@hus.gov.co
VENCIMIENTOS_CORREO_CRITICA=lider.financiero@hus.gov.co
VENCIMIENTOS_CORREO_VENCIDA=direccion.financiera@hus.gov.co,auditoria.interna@hus.gov.co

# ----- Metadatos de la app ----------------------------------
APP_NAME=Motor Glosas HUS
APP_VERSION=5.5.0

# ── Registro de errores (Sentry) ─────────────────────────────────────────────
# Sin esto, cuando el motor falla el error se pierde y toca adivinar.
# Cómo activarlo: cree una cuenta gratis en sentry.io (5.000 errores al mes),
# escoja «FastAPI» al crear el proyecto y pegue acá el DSN que le muestre.
# El motor no manda datos del paciente: el cuerpo de las peticiones se tacha
# antes de salir (ver app/core/sentry_init.py, `before_send`).
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
