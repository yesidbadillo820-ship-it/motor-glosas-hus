# Excluir archivos del build context Docker — acelera el build
# y evita que se copien a la imagen final.

# Git
.git/
.gitignore
.gitattributes

# Tests (no van a producción) — EXCEPTO el benchmark (tablero de calidad),
# que sí viaja con la imagen para poder medir el motor desde el contenedor.
tests/
!tests/benchmark/
!tests/benchmark/**

# Documentación
docs/
*.md
README*
CLAUDE*

# Tools (jump-box agent corre en la PC del HUS, no en el contenedor)
# EXCEPTO los scoreboards (tablero de calidad) y las herramientas del
# Centro de Automatización, que el motor importa en producción. Esta
# lista la vigila un test: si el catálogo crece y acá falta el módulo,
# la suite lo dice antes de que el auditor vea otro «ModuleNotFoundError».
tools/
!tools/scoreboard.py
!tools/scoreboard_live.py
!tools/_dinero.py
!tools/organizar_objeciones_savia.py
!tools/organizar_objeciones_vco.py
!tools/organizar_objeciones_emssanar.py
!tools/txt_a_excel.py
!tools/excel_a_csv.py
!tools/revisar_xml_facturas.py
!tools/convertir_tramite_masivo.py
# Recuperación del registro de envíos de pre-auditoría (incidente 31-07):
# se corre DENTRO del contenedor con docker exec, así que debe viajar.
!tools/preauditoria_reconstruir_envios.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenv local
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema
.DS_Store
Thumbs.db

# Logs locales
*.log
logs/

# Datos locales / dev DB
*.db
*.sqlite
*.sqlite3
glosas.db
local.db
**/*.db

# Ronda 30 — DATOS DE PACIENTES (PHI): en la VM el build context es
# /opt/motor-glosas, que contiene ./data con la BD de producción, los
# backups y los PDFs de soporte. El runtime los usa vía el volumen /data,
# NUNCA vía /app/data, así que excluirlos del build es inocuo y evita
# hornear historia clínica dentro de cada imagen Docker. Los 3 fixtures
# .json (plantillas, cláusulas, perfiles) sí viajan — ver COPY data/*.json
# en el Dockerfile.
data/soportes/
data/backups/
data/*.db
backups/

# Archivos sensibles que NUNCA deben ir al contenedor
.env
.env.*
!.env.example
*.pem
*.key
secrets.txt

# CI/CD / Render-specific (no aplica a Fly)
.render/
render.yaml

# Archivos grandes / temporales
*.zip
*.tar.gz
node_modules/
