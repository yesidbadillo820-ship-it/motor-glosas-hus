# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Entorno virtual
venv/
env/
.venv/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Base de datos (NUNCA subir al repo - puede contener datos de pacientes)
*.db
*.sqlite
*.sqlite3
# Artefactos WAL de SQLite (modo journal_mode=WAL en producción)
*.db-wal
*.db-shm
*.db-journal

# Logs
*.log
logs/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales de pruebas y uploads
uploads/
temp/
tmp/

# Test artifacts
junit.xml
.coverage
htmlcov/

# Pre-commit cache
.pre-commit-cache/

# Claude Code local settings (personal, no se commitea)
.claude/settings.local.json

# Self-hosted en HUS (deploy/) — secretos del túnel Cloudflare
# El config.yml.example SÍ se commitea (template), el real NO.
deploy/cloudflared/config.yml
deploy/cloudflared/*.json

# Carpeta de datos generada por install.sh (excepto los catálogos versionados)
data/
!data/plantillas_hus_base.json
!data/perfiles_radicacion.json

# Reporte por defecto del radicador de facturación (artefacto generado)
radicacion_reporte.csv

# Scratchpad temporal (datos sensibles del usuario, no commitear)
scratchpad/
